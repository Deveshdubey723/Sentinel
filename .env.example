PORT=3001
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_secret
MONGODB_URI=mongodb+srv://<username>:<url_encoded_password>@<cluster>.mongodb.net/sentinel_db?retryWrites=true&w=majority
MONGODB_DB=sentinel_db
SEED_DEMO_DATA=false
VITE_API_BASE=/api/v1
# Render backend CORS allow-list. Use the exact Vercel origin(s), comma-separated.
FRONTEND_URLS=https://your-sentinel.vercel.app
